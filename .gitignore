# =============================================================================
# Repo ini PUBLIK. Semua data sensus (data pribadi responden & akun petugas),
# rahasia (password), sesi login, dan artefak runtime JANGAN PERNAH di-commit.
# Satu-satunya pengecualian: folder templates/ (templat KOSONG / data fiktif).
# =============================================================================

# --- Konfigurasi lokal (password, akun, kode & data wilayah kabupaten Anda) ---
inti/config_lokal.py
.env

# --- Runtime Python / lingkungan ---
__pycache__/
*.pyc
.venv/
venv/
nul

# --- Data sumber & hasil (data pribadi responden: nama, NIK, HP, dll) ---
*.csv
*.xlsx
*.xlsm
*.xls
export/
list_api_*.json
dump_akun_mitra*.json

# --- Daftar kode wilayah/identitas milik Anda (hasil kerja lokal) ---
daftar*.txt
list*.txt

# --- File siap-tempel Console (berisi email petugas, nama usaha, password baru) ---
*.siap.js

# --- Log, screenshot, rekaman halaman & audit ---
log_screenshots/
log_fasih_sm/
log_approve/
audit_*.csv

# --- Profil & sesi browser (berisi cookie login!) ---
.profil_fasih_sm/
.profil_fasih_web_*/
.sesi_fasih_web_*.json
.proses_*.lock

# --- Pengecualian: templat kosong/fiktif untuk pengguna baru ---
!templates/
!templates/**
templates/**/__pycache__/

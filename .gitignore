# =============================================================================
# Repo ini PUBLIK. Data sensus (data pribadi responden & akun petugas), rahasia
# (password), sesi login, dan keluaran alat JANGAN PERNAH di-commit.
# Satu-satunya pengecualian: folder templates/ (templat kosong / data fiktif).
# =============================================================================

# --- Konfigurasi lokal (password, akun, kode & data wilayah kabupaten Anda) ---
inti/config_lokal.py
.env

# --- Runtime Python / lingkungan ---
__pycache__/
*.pyc
.venv/
venv/
nul

# --- Folder data milik Anda (hanya README-nya yang ikut git) ---
bahan/*
!bahan/README.md
audit/*
!audit/README.md
arsip/

# --- Keluaran alat: SEMUA alat menulis ke <alat>/hasil/ (laporan, *.siap.js, log,
#     screenshot, list_api_*.json, sesi & profil browser berisi cookie login) ---
hasil/

# --- Jaring pengaman: jenis berkas data di mana pun (mis. tersalin ke akar) ---
*.csv
*.xlsx
*.xlsm
*.xls
*.zip
*.bak-*
*.siap.js
export/
list_api_*.json
dump_akun_mitra*.json
daftar*.txt
list*.txt
log_*/
log_*.txt
audit_*.csv
.profil_*/
.sesi_*.json
.proses_*.lock
.status_*.json

# --- Catatan perintah pribadi (berisi email akun PPL) ---
run_*.txt

# --- Pengecualian: templat kosong/fiktif untuk pengguna baru ---
!templates/
!templates/**
templates/**/__pycache__/
